{
  "name": "SupportRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "subject": {
      "type": "string",
      "enum": [
        "\u0627\u0633\u062a\u0641\u0633\u0627\u0631 \u0639\u0627\u0645",
        "\u0637\u0644\u0628 \u062f\u0639\u0645 \u0641\u0646\u064a",
        "\u0637\u0644\u0628 \u0639\u0631\u0636 \u0633\u0639\u0631",
        "\u0634\u0643\u0648\u0649",
        "\u0623\u062e\u0631\u0649"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0637\u0644\u0628"
    },
    "message": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u062c\u062f\u064a\u062f",
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629",
        "\u062a\u0645 \u0627\u0644\u0631\u062f"
      ],
      "default": "\u062c\u062f\u064a\u062f",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629"
    },
    "admin_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0633\u0624\u0648\u0644"
    }
  },
  "required": [
    "name",
    "email",
    "subject",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
