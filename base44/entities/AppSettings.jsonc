{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "company_phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "company_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "company_address": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "company_tax_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "company_commercial_register": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "company_logo": {
      "type": "string",
      "title": "\u0634\u0639\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "fiscal_year_start": {
      "type": "string",
      "title": "\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "default_currency": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629",
      "default": "SAR"
    },
    "decimal_places": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u062e\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0634\u0631\u064a\u0629",
      "default": 2
    },
    "default_warehouse": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a"
    },
    "low_stock_threshold": {
      "type": "number",
      "title": "\u062d\u062f \u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0645\u0646\u062e\u0641\u0636",
      "default": 10
    },
    "pos_cashier_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0634\u064a\u0631 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a"
    },
    "pos_tax_rate": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0636\u0631\u064a\u0628\u0629 \u0646\u0642\u0627\u0637 \u0627\u0644\u0628\u064a\u0639",
      "default": 15
    },
    "onboarding_completed": {
      "type": "boolean",
      "title": "\u0627\u0643\u062a\u0645\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0623\u0648\u0644\u064a",
      "default": false
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}